{
  // Cloudflare Workers Static Assets — no Worker script required.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "beachbio",
  "compatibility_date": "2026-06-28",

  // Keep the public *.workers.dev URLs disabled. Without these, every deploy
  // re-enables them (Wrangler's default is "on"), exposing /tools/* unauthenticated.
  // The site is reached only via the custom domain beachbio.io (behind Access).
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
    // "single-page-application" returns index.html for any unmatched path with
    // a 200, which is the most permissive option. Switch to "404-page" if you
    // later add a custom public/404.html and want true 404 responses.
  }
}
